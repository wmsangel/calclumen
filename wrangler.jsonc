{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "calclumen",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference (name must match "name" above) — used by OpenNext.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "calclumen"
    }
  ],
  // Production domain: bind the apex to this Worker (DNS cutover from Vercel).
  // www.calclumen.com keeps redirecting to the apex; move it to the Worker or a
  // CF redirect rule once Vercel is retired.
  "routes": [
    { "pattern": "calclumen.com", "custom_domain": true }
  ]
}
