{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "calclumen",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference (name must match "name" above) — used by OpenNext.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "calclumen"
    }
  ]
  // Production domain (calclumen.com) is bound to this Worker as a Custom Domain
  // in the Cloudflare dashboard (Workers → calclumen → Domains & Routes), not via
  // a wrangler route — mirrors the costtrek setup. The dashboard atomically
  // replaces the old Vercel apex DNS record; wrangler refuses to delete it.
}
